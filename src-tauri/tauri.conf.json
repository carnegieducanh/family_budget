{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Budget",
  "version": "../package.json",
  "identifier": "com.familybudget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Family Budget",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "preventOverflow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MTNDNjEzNUMyMjZDMUUKUldRZWJDSmNFOFlUR2RXV1VsMUEvWmI2ZVJUN1p3NStLeGRKOTNlQ2U0alBSWHI0blpJODRqalgK",
      "endpoints": [
        "https://github.com/carnegieducanh/family_budget/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
